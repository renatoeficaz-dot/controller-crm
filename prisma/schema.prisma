// Schema do CRM — Kanban de contatos + mensagens de WhatsApp
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Coluna do Kanban (ex.: Novo, Em conversa, Negociando, Fechado)
model Stage {
  id               String    @id @default(cuid())
  name             String
  color            String    @default("#64748b")
  order            Int       @default(0)
  autoResponsavel  String? // nome do usuário atribuído automaticamente quando um lead entra nesta etapa
  // Alternativa ao autoResponsavel fixo: nomes separados por vírgula. Quando
  // preenchido, o lead que entra na etapa é atribuído a quem da lista tem
  // MENOS leads ativos agora (não é só um rodízio — é por carga real).
  distribuicaoPool String?
  contacts         Contact[]
  usuarios         User[]    @relation("UserKanbans") // usuários (não-admin) que enxergam esta coluna
  agentesQueParam  IaAgent[] @relation("StopAtStage") // agentes de IA configurados pra parar de responder a partir desta etapa
  createdAt        DateTime  @default(now())
}

// Contato / lead
model Contact {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  // Estado (UF) do lead identificado pela IA a partir do que ele conta na
  // conversa (ex.: "moro em Salvador") — complementa o DDD do telefone, que
  // nem sempre bate com onde a pessoa mora de fato.
  estado      String?
  // Gênero do lead ("masculino" | "feminino"), identificado pela IA a partir
  // do nome (pushName do WhatsApp ou nome cadastrado) assim que o lead entra.
  genero      String?
  // Tipo de cliente ("motoboy" | "uber" | "comerciante") — cadastrado manualmente.
  tipoCliente String?
  // CPF do lead — preenchido manualmente ou pela IA ao ler um documento (RG/CNH) recebido.
  cpf         String?
  notes       String?
  order       Int       @default(0)
  stage       Stage     @relation(fields: [stageId], references: [id])
  stageId     String
  messages    Message[]

  // Financeiro / cobrança
  valorCapital     Float? // valor do empréstimo (base do cálculo dos honorários)
  pagamentoCapital DateTime? // data da entrega do capital; 1ª cobrança = +1 dia
  responsavel      String? // usuário responsável pela lead
  cicloAtual       Int                @default(1) // ciclo de empréstimo atual (renovações incrementam)
  tags             Tag[]              @relation("ContactTags")
  parcelas         Parcela[]
  tasks            Task[]
  lancamentos      Lancamento[]
  tentativas       TentativaContato[]
  responsavelLogs  ResponsavelLog[]

  // Atendimento manual: enquanto true, a IA não responde esse lead — o
  // humano assumiu a conversa. É ligado automaticamente ao mover o lead pra
  // "Cravo", e pode ser ligado/desligado manualmente pelo botão no chat/popup do lead.
  iaPausada Boolean @default(false)

  // Quando o lead entrou na etapa ATUAL — reseta a cada mudança de coluna.
  // Serve pro contador "há quanto tempo está parado aqui" no card do funil.
  // Não usa updatedAt porque aquele muda a cada edição de qualquer campo.
  entrouEtapaEm DateTime?

  // Timestamp de quando o lead ENTROU na etapa "Recebimento" (venda concluída).
  // Independente do pagamentoCapital (que tem sua própria lógica condicional
  // pra gerar parcelas) — usado só pra contar "vendas do dia" na aba Metas.
  entrouRecebimentoEm DateTime?

  // Puxada (consulta de crédito) em PDF — fica fixa no card do lead, sempre
  // visível ao abrir, diferente da mídia trocada na conversa (que rola no chat).
  puxadaUrl      String?
  puxadaFileName String?
  puxadaEm       DateTime?

  // Dados estruturados extraídos da mesma consulta que gera o PDF da puxada.
  // Ficam em colunas próprias (e não só dentro do PDF) pra alimentar o score
  // de risco e poderem ser cruzados nos relatórios depois.
  puxadaRenda       Float? // renda presumida mensal
  puxadaClasse      String? // classe social (A/B/C/D/E)
  puxadaEmprestimos Int? // empréstimos ativos (não quitados) em outros bancos
  puxadaCcf         Int? // registros de cheque sem fundo
  puxadaProcessos   Int? // processos judiciais encontrados
  puxadaObito       Boolean? // flag de óbito na base da Receita
  // Score 0-100 (quanto maior, melhor) calculado em lib/scoreCredito.js.
  // É consultivo: aparece no card pra apoiar a decisão, não bloqueia nada.
  puxadaScore       Int?
  puxadaRisco       String? // "baixo" | "medio" | "alto" | "bloqueio"
  puxadaLimite      Float? // limite de capital sugerido, em R$
  puxadaMotivos     String? // motivos do score, separados por "|"

  // Score comportamental: como o cliente paga NA SUA carteira (o da puxada vem
  // de bureau externo). Recalculado a cada baixa e uma vez por dia.
  scoreComportamental Int?
  scoreComportMotivos String?
  scoreComportEm      DateTime?

  // true quando esse lead chegou a entrar em "Cravo" (parou de pagar) alguma
  // vez — fica marcado pra sempre, mesmo que ele saia de Cravo depois, pra
  // alimentar o bloqueio de CPF reincidente noutro cadastro.
  deuCalote Boolean @default(false)

  // Motivo estruturado de recusa/perda — preenchido ao mover pra "Venda perdida".
  motivoPerda String?
  perdidoEm   DateTime?

  // Organização do funil (itens 54/55): fixar no topo da coluna, cor manual.
  fixado  Boolean @default(false)
  corCard String?

  // Contatos de referência (item 73) — quem acionar quando o cliente some.
  // Um lead pode ter vários (mãe, cônjuge, vizinho...), por isso é uma lista
  // à parte em vez de 3 campos soltos no Contact.
  referencias ContatoReferencia[]

  // Organização do Chat (itens 81/82) — independente do "fixado" do funil,
  // porque fixar no Kanban e fixar no Chat são decisões de telas diferentes.
  chatFixado    Boolean @default(false)
  chatArquivado Boolean @default(false)

  // "Não perturbe" temporário (item 98) — enquanto no futuro, a cobrança
  // automática (régua/lembrete) pula esse lead. Não afeta atendimento manual.
  naoPerturbarAte DateTime?

  // Exclusão reversível: contato "excluído" some das telas mas fica recuperável
  // por 24h antes de um job apagar de vez — é o "desfazer" depois de excluir.
  excluidoEm DateTime?

  // Campos personalizados definidos pelo admin (CampoPersonalizado), guardados
  // como JSON {"chaveDoCampo": "valor"}. Um por contato é suficiente — não
  // precisa de tabela própria pra um punhado de campos livres.
  camposCustom String?

  // Preenchimento guiado (formulário público ou "um por um" no chat): guarda
  // em que ponto do formCampos da campanha o lead está, pra IA/sistema saber
  // qual pergunta fazer a seguir. null = não está em preenchimento guiado.
  formularioEmAndamento   Boolean @default(false)
  formularioProximoIndice Int     @default(0)

  documentos         Documento[]
  etapaLogs          EtapaLog[]
  mensagensAgendadas MensagemAgendada[]

  negociacoes Negociacao[]

  // Link de rastreamento (UTM) que trouxe esse lead — atribuição de primeiro
  // toque: setado uma vez, na criação, a partir da tag "[ref:slug]" que o
  // redirecionamento /l/[slug] injeta na mensagem pré-preenchida do WhatsApp.
  campanha   LinkCampanha? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  campanhaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Link de redirecionamento pro WhatsApp (com UTM/região) pra rastrear de onde
// vêm as leads — cada campanha vira uma URL curta "/l/slug" que conta cliques
// e injeta uma tag na 1ª mensagem pra atribuir o lead a ela automaticamente.
model LinkCampanha {
  id          String         @id @default(cuid())
  nome        String
  slug        String         @unique
  numero      WhatsappNumber @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  numeroId    String
  regiao      String? // livre — UF, cidade, nome da praça de mídia, etc.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  mensagem    String? // texto pré-preenchido no wa.me (além da tag de rastreio, automática)

  // Como coletar os dados do lead antes/ao entrar em contato:
  // "chat" (padrão, comportamento de sempre — vai direto pro wa.me) |
  // "formulario" (mostra um formulário em /f/[slug] antes de ir pro WhatsApp) |
  // "perguntar" (deixa o lead escolher entre as duas opções acima).
  modoColeta String  @default("chat")
  // Definição dos campos do formulário/perguntas, em JSON:
  // [{"chave":"renda","label":"Renda mensal","tipo":"texto"}, ...]
  formCampos String?

  cliques    Int          @default(0)
  leads      Contact[]
  cliquesLog LinkClique[]
  createdAt  DateTime     @default(now())
}

// Documento anexado ao lead, separado por TIPO (RG, comprovante de renda,
// selfie, comprovante de endereço, contrato...) — diferente da mídia solta no
// chat, que fica junto de qualquer conversa. Pode nascer de um upload manual
// ou ser promovido a partir de uma mídia recebida no chat.
model Documento {
  id           String    @id @default(cuid())
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId    String
  tipo         String // "rg" | "cnh" | "comprovante_renda" | "comprovante_endereco" | "selfie" | "contrato" | "outro"
  url          String
  fileName     String?
  mimeType     String?
  conferido    Boolean   @default(false)
  conferidoPor String?
  conferidoEm  DateTime?
  createdAt    DateTime  @default(now())
}

// Cada mudança de etapa do lead — alimenta a linha do tempo unificada da ficha
// (junto com baixas, tentativas e negociações, que já têm seus próprios logs).
model EtapaLog {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  deEtapa   String?
  paraEtapa String
  usuario   String?
  createdAt DateTime @default(now())
}

// Visão de filtro salva (Contatos/Cobrança) — pra não montar o mesmo filtro
// toda vez. "Meus atrasados SP" vira um clique.
model VisaoSalva {
  id        String   @id @default(cuid())
  usuario   String? // null = compartilhada com todo mundo
  tela      String // "contatos" | "cobranca"
  nome      String
  filtros   String // JSON
  createdAt DateTime @default(now())
}

// Campo personalizado definido pelo admin — os VALORES ficam em
// Contact.camposCustom (JSON), esta tabela só guarda a DEFINIÇÃO do campo.
model CampoPersonalizado {
  id     String  @id @default(cuid())
  chave  String  @unique // usada como chave no JSON de Contact.camposCustom
  label  String
  tipo   String  @default("texto") // "texto" | "numero" | "data" | "opcoes"
  opcoes String? // CSV, quando tipo = "opcoes"
  ordem  Int     @default(0)
}

// Registro individual de cada clique num link — dispositivo/navegador (pelo
// User-Agent), região (geoip por IP, best-effort) e as UTMs que vieram na
// própria URL do clique (ex.: anúncio do Facebook/Google que anexa as suas).
model LinkClique {
  id          String       @id @default(cuid())
  campanha    LinkCampanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  campanhaId  String
  dispositivo String? // "Celular" | "Tablet" | "Computador"
  navegador   String? // "Chrome" | "Safari" | "Instagram (in-app)" | etc.
  regiao      String? // "Cidade - UF", best-effort via geoip do IP
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  createdAt   DateTime     @default(now())
}

// Parcela diária de cobrança (10 por empréstimo)
model Parcela {
  id             String           @id @default(cuid())
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String
  number         Int // 1..10
  dueDate        DateTime
  amount         Float
  paid           Boolean          @default(false)
  paidAt         DateTime?
  ciclo          Int              @default(1) // 1 = primeiro empréstimo, 2 = 1ª renovação, etc.
  // Valor realmente cobrado na baixa (pode ser diferente de `amount` quando o
  // cobrador escolhe baixar SEM o juro de atraso, pra aliviar o cliente).
  // null = ainda não paga.
  amountPago     Float?
  // Soma de baixas PARCIAIS já recebidas dessa parcela (item 93) — enquanto
  // for menor que o valor devido, a parcela continua `paid = false` mas já
  // tem dinheiro registrado. Vira lançamento de entrada a cada incremento.
  valorPago      Float            @default(0)
  // Nome de quem deu a baixa — alimenta o comparativo entre cobradores e o
  // cálculo de comissão (quem efetivamente recuperou o valor).
  baixadoPor     String?
  // "pix" | "dinheiro" | "outro" — dinheiro em espécie fica em mãos do
  // cobrador até ele depositar (ver EspecieMovimento). null = não informado
  // (baixas antigas, de antes desse controle existir).
  formaPagamento String?
  // true = essa parcela foi substituída por um acordo parcelado (Negociacao) e
  // não deve mais contar como "em aberto" nem entrar em cobrança — o valor
  // dela virou as novas parcelas do acordo.
  renegociada    Boolean          @default(false)
  // true = essa parcela foi GERADA por um acordo parcelado (em vez de fazer
  // parte do plano original de 10). Numeração própria (1000+) pra não colidir.
  deAcordo       Boolean          @default(false)
  task           Task?
  alteracoes     AlteracaoBaixa[]
  ajustes        ParcelaAjuste[]
  descontos      SolicitacaoDesconto[]
}

// Vencimento alterado ou parcela adiada (itens 103/104) — sempre com motivo,
// mesmo padrão de auditoria do AlteracaoBaixa (que é só pra valor de baixa).
// Item 165: desconto pontual numa parcela pedido pelo cobrador, mas que só
// vale depois de um admin aprovar — evita que qualquer um reduza uma dívida
// sozinho.
model SolicitacaoDesconto {
  id            String    @id @default(cuid())
  parcela       Parcela   @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  parcelaId     String
  contactNome   String
  parcelaNumero Int
  valorOriginal Float
  valorPedido   Float
  motivo        String
  solicitadoPor String?
  status        String    @default("pendente") // "pendente" | "aprovado" | "recusado"
  respondidoPor String?
  respondidoEm  DateTime?
  createdAt     DateTime  @default(now())
}

model ParcelaAjuste {
  id               String   @id @default(cuid())
  parcela          Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  parcelaId        String
  vencimentoAntes  DateTime
  vencimentoDepois DateTime
  motivo           String
  usuario          String?
  createdAt        DateTime @default(now())
}

// Registro de cada negociação feita com o cliente — acordo parcelado aceito,
// desconto de quitação à vista oferecido/recusado, ou anotação livre do
// cobrador. Histórico consultável na ficha do lead.
model Negociacao {
  id             String   @id @default(cuid())
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String
  tipo           String // "acordo_parcelado" | "desconto_aceito" | "desconto_recusado" | "outro"
  valorOriginal  Float?
  valorNegociado Float?
  parcelas       Int? // nº de parcelas do acordo, quando tipo = acordo_parcelado
  aceito         Boolean  @default(true)
  notas          String?
  usuario        String?
  createdAt      DateTime @default(now())
}

// Tempo de uso do sistema por colaborador, por dia — só conta enquanto o
// mouse/teclado estiveram ativos nos últimos 60s E a aba estava em primeiro
// plano (ver components/UsoAtivoTracker.jsx), pra não contar "deixei aberto
// e fui embora" como uso.
model UsoDiario {
  id       String   @id @default(cuid())
  usuario  String
  dia      DateTime
  segundos Int      @default(0)
  // Momento do último heartbeat aceito. Sem isso, chamar a API em laço
  // inflava o tempo de uso à vontade — e esse número serve pra avaliar
  // colaborador, então precisa ser difícil de forjar.
  ultimoEm DateTime?

  @@unique([usuario, dia])
}

// Item 191: histórico de quem já foi responsável por esse lead — sem isso,
// depois de uma transferência (item 185) ou edição manual, ninguém consegue
// dizer quem cuidava do cliente antes.
model ResponsavelLog {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  de        String?
  para      String?
  usuario   String? // quem fez a mudança
  createdAt DateTime @default(now())
}

// Log de alterações feitas numa baixa já registrada (mudar o valor cobrado,
// ou desmarcar como paga) — sempre com motivo, pra auditoria. Aparece na
// aba "Alterações" em Configurações.
// Contato de referência do lead (item 73) — família, vizinho, amigo... quem o
// cobrador aciona quando o próprio cliente para de responder. Cada lead pode
// ter vários; o telefone só precisa dar pra abrir o WhatsApp, não é um número
// cadastrado no sistema (não gera Contact nem entra na IA).
model ContatoReferencia {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  nome      String
  telefone  String
  relacao   String? // "familiar" | "vizinho" | "amigo" | "trabalho" | "outro"
  createdAt DateTime @default(now())
}

model AlteracaoBaixa {
  id            String   @id @default(cuid())
  parcela       Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  parcelaId     String
  contactNome   String // denormalizado — segue legível mesmo se o lead for excluído depois
  parcelaNumero Int
  valorAntigo   Float?
  valorNovo     Float?
  motivo        String
  usuarioNome   String?
  createdAt     DateTime @default(now())
}

// Tarefa do responsável pela lead (uma por parcela, na data do pagamento)
model Task {
  id          String    @id @default(cuid())
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String
  parcela     Parcela?  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  parcelaId   String?   @unique
  title       String
  notes       String?
  dueDate     DateTime
  done        Boolean   @default(false)
  tipo        TaskType? @relation(fields: [tipoId], references: [id], onDelete: SetNull)
  tipoId      String?
  // A quem essa tarefa foi atribuída (item 111) — pode ser diferente do
  // responsável pelo lead: um vendedor pode delegar uma visita ao cobrador.
  // null = segue implícito o responsável do lead, como sempre foi.
  responsavel String?
  createdAt   DateTime  @default(now())
}

// Tipo de tarefa configurável (ex.: "Ligação", "Visita", "Cobrança extra")
model TaskType {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  emoji     String?
  tasks     Task[]
  createdAt DateTime @default(now())
}

// Mensagem pronta (modelo de texto/mídia/contato) para envio rápido aos contatos
model MessageTemplate {
  id            String             @id @default(cuid())
  title         String // nome curto que aparece no seletor
  body          String             @default("") // texto da mensagem (ou legenda para mídia)
  mediaType     String? // null/"text" | "image" | "audio" | "document" | "contact"
  mediaUrl      String? // caminho do arquivo em /uploads (image/audio/document)
  mediaMimetype String?
  mediaFileName String?
  contactName   String? // para tipo "contact"
  contactPhone  String?
  order         Int                @default(0)
  // true = criada por dentro de outro fluxo (ex.: áudio gravado na hora pra
  // agendar) e não deve aparecer na lista de "Mensagens prontas" do chat.
  interno       Boolean            @default(false)
  createdAt     DateTime           @default(now())
  agendamentos  MensagemAgendada[]
}

// Configurações globais do sistema (linha única)
model Config {
  id                  String  @id @default("singleton")
  honorariosPct       Float   @default(30) // % cobrado sobre o Valor do capital
  multaPct            Float   @default(50) // % de multa aplicado à parcela vencida (juros por atraso)
  pagamentoHoraLimite String? // "HH:MM" — após esse horário, a parcela que vence hoje já conta como atrasada
  evolutionUrl        String? // URL do servidor Evolution (ex.: https://evo.exemplo.com)
  evolutionApiKey     String? // API Key global da Evolution
  wahaUrl             String? // URL do servidor WAHA (ex.: http://ip:3001)
  wahaApiKey          String? // API Key global do WAHA

  // Meta diária: X% de todos os leads atualmente na etapa "Recebimento"
  // precisam pagar (dar baixa numa parcela) hoje. 3 níveis: mínima < média < meta
  // (meta = metaPctRecebimento, o valor "ideal"/cheio, já existia antes).
  metaPctRecebimentoMinima Float @default(40)
  metaPctRecebimentoMedia  Float @default(55)
  metaPctRecebimento       Float @default(70)
  // Meta diária de vendas em R$ liberado (complementa a meta por quantidade:
  // 3 empréstimos de 300 e 3 de 900 contam igual na quantidade, mas não no
  // dinheiro que saiu). 0 = meta de valor desligada.
  metaValorVendasMinima    Float @default(0)
  metaValorVendasMedia     Float @default(0)
  metaValorVendasDia       Float @default(0)

  // Meta diária de RECUPERAÇÃO: quanto em R$ deve entrar de parcelas que já
  // estavam atrasadas. Fica separada do recebimento normal porque cobrar quem
  // atrasou é outro esforço. 0 = desligada.
  metaRecuperacaoMinima Float @default(0)
  metaRecuperacaoMedia  Float @default(0)
  metaRecuperacaoDia    Float @default(0)

  // Meta diária de vendas: quantos leads devem cair em "Recebimento" no dia.
  // 3 níveis: mínima < média < meta (metaVendasDia = a meta cheia, já existia antes).
  metaVendasMinima Int @default(2)
  metaVendasMedia  Int @default(3)
  metaVendasDia    Int @default(5)

  // Horário comercial da automação de responsável por etapa — fora dessa janela,
  // o lead entra na etapa mas NÃO é auto-atribuído (fica sem responsável até
  // alguém pegar manualmente ou até a próxima checagem dentro do horário).
  // Vazio = automação sempre ativa, sem restrição de horário.
  horarioComercialInicio String? // "HH:MM"
  horarioComercialFim    String? // "HH:MM"

  // IA: DeepInfra hospeda texto (Llama) e transcrição (Whisper), compartilhados por
  // todos os agentes. Cada agente pode escolher usar áudio da DeepInfra também, ou
  // de um provedor de voz dedicado (Fish Audio / ElevenLabs) usando o token abaixo.
  // Oferta de quitação à vista pra quem já está bem atrasado — recuperar parte
  // vale mais que insistir num valor cheio que provavelmente não vem.
  descontoAtivo    Boolean @default(false)
  descontoPct      Float   @default(20) // % de desconto sobre o total em aberto
  descontoDiasMin  Int     @default(15) // só oferece a partir de X dias de atraso
  descontoMensagem String?

  // Alertas no WhatsApp do dono: resumo do dia no horário escolhido e avisos
  // na hora quando acontece algo crítico (número caiu, calote grande).
  alertaWhatsapp     String?
  alertaResumoDiario Boolean @default(false)
  alertaHora         String? // "HH:MM"
  alertaCriticos     Boolean @default(true)
  alertaCapitalMin   Float   @default(500) // só avisa calote acima disso

  deepinfraApiKey  String? // token da conta em https://deepinfra.com/dash
  fishAudioApiKey  String? // token da conta em https://fish.audio
  elevenLabsApiKey String? // token da conta em https://elevenlabs.io

  // Conta de onde sai o dinheiro do capital liberado ao lead (débito automático
  // em Lançamentos ao entrar em "Recebimento"). Configurável pois pode mudar.
  contaLiberacao   Banco?  @relation("ContaLiberacao", fields: [contaLiberacaoId], references: [id], onDelete: SetNull)
  contaLiberacaoId String?

  // Conta onde entra o dinheiro das parcelas pagas pelo cobrador (crédito
  // automático em Lançamentos ao dar baixa numa parcela).
  contaRecebimento   Banco?  @relation("ContaRecebimento", fields: [contaRecebimentoId], references: [id], onDelete: SetNull)
  contaRecebimentoId String?

  // Capital escalonado: 1º empréstimo trava num valor baixo, e só sobe a cada
  // ciclo pago (renovação). limite(ciclo) = escalonamentoBase +
  // escalonamentoIncremento * (ciclo - 1), até escalonamentoTeto (se definido).
  escalonamentoAtivo      Boolean @default(false)
  escalonamentoBase       Float   @default(300)
  escalonamentoIncremento Float   @default(200)
  escalonamentoTeto       Float?

  // Bloqueio de CPF reincidente: ao tentar avançar um lead cujo CPF já deu
  // calote noutro cadastro (Contact.deuCalote), avisa/bloqueia.
  bloqueioCpfAtivo Boolean @default(true)

  // Escalonamento por tempo de atraso: passou de X dias, o responsável pela
  // lead muda automaticamente pro cobrador sênior configurado aqui.
  escalonamentoAtrasoDias        Int?
  escalonamentoAtrasoResponsavel String?

  // Capital ocioso: avisa se o saldo em caixa fica X dias sem nenhuma
  // liberação de capital (saída de Lançamento vinculada a um lead).
  capitalOciosoDias Int @default(3)

  // Provisão pra devedores duvidosos — % da carteira aberta que se espera
  // NÃO recuperar, por faixa de atraso (referência pra decisão de quanto
  // emprestar, não é lançamento contábil automático).
  provisaoPct0a7    Float @default(2)
  provisaoPct8a15   Float @default(10)
  provisaoPct16a30  Float @default(35)
  provisaoPct31mais Float @default(70)

  // SLA de primeira resposta: alerta no card do funil quando um lead NOVO fica
  // mais de X minutos sem nenhuma mensagem nossa. null = alerta desligado.
  slaPrimeiraRespostaMin Int?

  // Aviso de acúmulo: mostra um selo na coluna do funil quando ela passa desse
  // número de leads. null/0 = desligado.
  avisoAcumuloLimite Int?

  // Pix pra gerar o Copia-e-Cola/QR Code de cada parcela (item 20). Sem chave
  // configurada, o botão de Pix simplesmente não aparece.
  pixChave         String?
  pixNomeRecebedor String?
  pixCidade        String?

  // Mensagem diária automática com o Pix pra quem está EM DIA (nenhuma parcela
  // atrasada) — manda sozinho, sem depender do cobrador. Atrasado NUNCA entra
  // aqui: esse é trabalho do cobrador, via fila de cobrança/régua normal.
  pixAdimplentesAtivo     Boolean @default(false)
  pixAdimplentesDiasAntes Int     @default(0) // 0 = só no dia do vencimento; 1 = já manda na véspera também
  pixAdimplentesHora      String  @default("08:00") // "HH:MM" — horário alvo do envio
  pixAdimplentesMensagem  String?
}

// Configuração de comissão dos cobradores — bônus por bater a meta de valor
// recuperado no dia e/ou na semana (segunda a sábado, dia de folga é domingo).
model ComissaoConfig {
  id               String @id @default("singleton")
  metaDiariaValor  Float  @default(0) // R$ recuperados no dia pra bater a meta diária
  bonusDiario      Float  @default(0) // quanto ganha ao bater
  metaSemanalValor Float  @default(0) // R$ recuperados na semana (seg-sáb) pra bater a meta semanal
  bonusSemanal     Float  @default(0)

  // Item 221: bônus progressivo por faixa de valor recuperado na semana —
  // além do bônus fixo acima. Desligado por padrão (não altera pagamento já
  // em curso sem o admin ligar antes). Faixas em ComissaoFaixa.
  progressivaAtiva Boolean @default(false)

  // Item 223: desconto por lead perdido na semana (Contact.perdidoEm) do
  // responsável — 0 desliga, igual toda outra meta em R$ do sistema.
  descontoPorPerdaValor Float @default(0)
}

// Faixas do bônus progressivo (item 221) — quem recuperar >= minValor na
// semana ganha pctBonus% sobre TUDO que recuperou (não é marginal por
// faixa, é "bateu a faixa, ganha o % dela inteiro" — mais fácil de explicar
// pro cobrador do que uma conta em degraus).
model ComissaoFaixa {
  id        String @id @default(cuid())
  minValor  Float
  pctBonus  Float
}

// Um "agente" de IA: prompt + modelos próprios. Cada número de WhatsApp escolhe
// qual agente atende (ou nenhum).
model IaAgent {
  id           String  @id @default(cuid())
  name         String
  prompt       String? // instruções de como esse agente deve atender
  textModel    String? // modelo de texto na DeepInfra (ex.: meta-llama/Meta-Llama-3.1-8B-Instruct)
  ttsProvider  String  @default("deepinfra") // "deepinfra" | "fishaudio" | "elevenlabs"
  ttsModel     String? // modelo de áudio na DeepInfra (ex.: ResembleAI/chatterbox-turbo) — só quando ttsProvider = deepinfra
  ttsVoice     String? // voz/referência: nome da voz (Kokoro), reference_id (Fish Audio) ou voice_id (ElevenLabs)
  modoResposta String  @default("espelho") // "espelho" (áudio→áudio, texto→texto) | "texto" | "audio"

  // Funções que a IA pode chamar sozinha durante a conversa (function calling)
  toolSendContact  Boolean @default(false) // pode enviar um contato (vCard) configurado abaixo
  toolContactName  String? // nome do contato que a função "enviar contato" manda
  toolContactPhone String? // telefone do contato que a função "enviar contato" manda
  toolSendTemplate Boolean @default(false) // pode enviar uma das mensagens prontas (inclui áudios pré-gravados)
  toolMoveStage    Boolean @default(false) // pode mover o lead para outra etapa do funil

  // A partir desta etapa (e qualquer etapa depois dela na ordem do funil), a IA
  // para de responder — o atendimento passa a ser 100% humano. null = nunca para.
  stopAtStage   Stage?  @relation("StopAtStage", fields: [stopAtStageId], references: [id], onDelete: SetNull)
  stopAtStageId String?

  numeros   WhatsappNumber[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Usuário do sistema (cadastro em Configurações) — também faz login no app.
model User {
  id              String           @id @default(cuid())
  name            String
  login           String           @unique
  passwordHash    String
  role            String           @default("vendedor") // admin | vendedor | cobrador
  verTodosLeads   Boolean          @default(false) // false = só leads onde é responsável
  numeros         WhatsappNumber[] @relation("NumeroResponsavel") // números atribuídos (ownership)
  numerosVisiveis WhatsappNumber[] @relation("NumeroVisibilidade") // WhatsApp cujas mensagens pode ver
  kanbansVisiveis Stage[]          @relation("UserKanbans") // colunas do funil que pode ver
  // Páginas do sistema que pode acessar (chaves de lib/paginas.js, separadas por
  // vírgula — ex.: "contatos,chat"). Vazio/null = todas. Não cobre Lançamentos/
  // Configurações, que continuam exclusivas de admin independente disso.
  paginasVisiveis String?

  // Meta de vendas individual (vendedor) — null em qualquer um dos 3 campos
  // significa "usa a meta global" (Config.metaVendas*).
  metaVendasMinimaPropria Int?
  metaVendasMediaPropria  Int?
  metaVendasDiaPropria    Int?

  // Permissões pontuais além do que o `role` já libera por padrão — CSV de
  // chaves (ver lib/permissoes.js). Só adiciona; nunca tira o que o role dá.
  // Ex.: um "vendedor" com "editar_valor_baixa" na lista ganha essa ação
  // específica sem virar admin.
  permissoesExtras String?

  // Modo somente leitura (item 146) — vê tudo (contador, auditoria), mas o
  // servidor recusa qualquer POST/PATCH/DELETE, mesmo se a tela tentar mandar.
  somenteLeitura Boolean @default(false)

  // Último login — mostrado em Configurações → Usuários (item 139).
  ultimoAcessoEm DateTime?

  // Equipe (item 117): meta agregada de um grupo, além da meta individual.
  equipe   Equipe? @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  equipeId String?

  createdAt DateTime @default(now())
}

// Equipe de vendedores/cobradores — meta em cima do grupo, além da meta
// individual de cada um. null nos campos = não define meta própria de equipe.
model Equipe {
  id                       String   @id @default(cuid())
  nome                     String   @unique
  metaVendasMinima         Int?
  metaVendasMedia          Int?
  metaVendasDia            Int?
  metaPctRecebimentoMinima Float?
  metaPctRecebimentoMedia  Float?
  metaPctRecebimento       Float?
  membros                  User[]
  createdAt                DateTime @default(now())
}

// Número de WhatsApp conectado (uma instância da Evolution), atribuível a um usuário
model WhatsappNumber {
  id                 String   @id @default(cuid())
  label              String // nome amigável (ex.: "Comercial 1")
  number             String // número (ex.: 5511999998888)
  instance           String // nome da instância (Evolution) ou sessão (WAHA)
  provider           String   @default("evolution") // "evolution" | "waha" — qual API atende este número
  user               User?    @relation("NumeroResponsavel", fields: [userId], references: [id], onDelete: SetNull)
  userId             String?
  usuariosVisualizam User[]   @relation("NumeroVisibilidade") // usuários que podem ver as mensagens deste número
  agent              IaAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId            String? // agente de IA que atende neste número (null = IA desligada aqui)

  // Cobrança automática: estados (UF) que este número atende, pelo DDD do
  // cliente (ex.: "SP,MG"), e a mensagem enviada diariamente antes do horário
  // limite de pagamento pra quem está em "Recebimento".
  estadosCobranca  String?
  mensagemCobranca String?

  // Proxy dedicado pra esse número (recomendado: residencial/mobile, nunca
  // datacenter) — evita o WhatsApp banir na hora por detectar IP de VPS.
  // Cada número deve ter um IP diferente; nunca compartilhar entre números.
  proxyServer   String? // "host:porta", sem protocolo
  proxyUsername String?
  proxyPassword String?

  // Aquecimento: número recém-conectado que dispara volume alto é banido na
  // hora. Enquanto ativo, o envio automático respeita um teto que cresce com
  // os dias de uso (ver lib/aquecimento.js).
  aquecimentoAtivo Boolean   @default(false)
  aquecimentoDesde DateTime?

  // Item 175: teto de envios automáticos POR HORA — separado do teto diário
  // de aquecimento acima, vale sempre (mesmo número já aquecido) pra evitar
  // rajada concentrada, que é outro padrão que o WhatsApp watch. null = sem teto.
  limiteEnviosHora Int?

  // Número padrão (só um por vez) — destacado na lista.
  padrao             Boolean            @default(false)
  // Rastreamento de conexão: usado pra mostrar "Conectado em ..." /
  // "Desconectado em ..." e alimentar o histórico (ConexaoLog).
  ultimoEstado       String? // último estado conhecido na Evolution ("open" | "close" | "connecting")
  conectadoEm        DateTime?
  desconectadoEm     DateTime?
  logs               ConexaoLog[]
  campanhas          LinkCampanha[]
  mensagensAgendadas MensagemAgendada[]

  createdAt DateTime @default(now())
}

// Histórico de conexão/desconexão de cada número (pra tela "Ver histórico de conexões").
model ConexaoLog {
  id        String         @id @default(cuid())
  numero    WhatsappNumber @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  numeroId  String
  evento    String // "conectado" | "desconectado"
  createdAt DateTime       @default(now())
}

// Log de lembretes de cobrança já enviados (evita mandar 2x no mesmo dia).
// Régua de cobrança: qual mensagem enviar conforme os dias de atraso. É global
// (o número de WhatsApp define QUEM envia, pelo estadosCobranca; a régua define
// O QUE dizer). Sem nenhuma regra ativa, o lembrete cai no comportamento antigo
// de usar a mensagem única do próprio número.
model RegraCobranca {
  id            String  @id @default(cuid())
  diasMin       Int // -1 = véspera do vencimento, 0 = vence hoje, 1+ = dias de atraso
  diasMax       Int? // null = sem teto (faixa final, ex.: "+16 dias")
  mensagem      String
  ativa         Boolean @default(true)
  ordem         Int     @default(0)
  // Canal recomendado pro cobrador nessa faixa de atraso — aparece como selo na
  // fila de cobrança. Puramente indicativo (não bloqueia nem automatiza o envio).
  canalSugerido String? // "whatsapp" | "ligacao" | "presencial" | "notificacao"
}

// Catálogo de motivos de recusa/perda, editável em Configurações — alimenta o
// select ao mover um lead pra "Venda perdida" (Contact.motivoPerda).
model MotivoPerda {
  id    String @id @default(cuid())
  nome  String @unique
  ordem Int    @default(0)
}

// Cada tentativa de contato feita pelo cobrador (ligou, foi no endereço...) —
// serve pra medir esforço real gasto por cliente, não só o resultado.
model TentativaContato {
  id           String    @id @default(cuid())
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId    String
  tipo         String // "ligacao" | "whatsapp" | "presencial"
  resultado    String // "atendeu" | "nao_atendeu" | "prometeu" | "recusou" | "numero_errado"
  // Data prometida de pagamento, quando resultado = "prometeu" — usado pra
  // sinalizar promessa quebrada na fila de cobrança se passar sem pagamento.
  dataPromessa DateTime?
  notas        String?
  usuario      String? // quem registrou
  createdAt    DateTime  @default(now())
}

// Tentativas de login que FALHARAM — base do bloqueio por força bruta.
// Fica no banco, e não em memória, pelo mesmo motivo do AlertaEnviado: memória
// zera a cada deploy/restart, e aí bastaria esperar um restart pra zerar o
// contador de tentativas.
model LoginTentativa {
  id        String   @id @default(cuid())
  login     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([ip, createdAt])
}

// Trava de "esse alerta já foi mandado", no banco e não em memória: a memória
// zera a cada deploy/restart do container, e aí todo alerta crítico já avisado
// (número caído, calote acima do limite, capital ocioso) era mandado de novo
// no WhatsApp do dono a cada subida.
model AlertaEnviado {
  id        String   @id @default(cuid())
  chave     String   @unique
  createdAt DateTime @default(now())
}

model LembreteCobrancaLog {
  id        String   @id @default(cuid())
  contactId String
  dia       DateTime // meia-noite UTC do dia do lembrete
  createdAt DateTime @default(now())

  @@unique([contactId, dia])
}

// Um por contato por dia — evita mandar a mensagem de Pix duas vezes no mesmo dia.
model PixAdimplenteLog {
  id        String   @id @default(cuid())
  contactId String
  dia       DateTime
  createdAt DateTime @default(now())

  @@unique([contactId, dia])
}

// Histórico de atribuições automáticas de responsável (uma linha por vez que
// a automação por etapa realmente atribuiu alguém a um lead).
model AtribuicaoLog {
  id          String   @id @default(cuid())
  contactId   String
  contactName String // snapshot — continua legível mesmo se o lead for excluído depois
  stageName   String
  responsavel String
  createdAt   DateTime @default(now())
}

// Etiqueta (tag) atribuível a leads
model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("#6366f1") // cor do badge
  contacts  Contact[]     @relation("ContactTags")
  rules     AutoTagRule[]
  createdAt DateTime      @default(now())
}

// Regra de auto-tag: se a 1ª mensagem do cliente contém o texto, atribui a tag.
model AutoTagRule {
  id        String   @id @default(cuid())
  match     String // texto que a 1ª mensagem deve conter (case-insensitive)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())
}

// Categoria de lançamento (entrada ou saída)
model LancamentoCategoria {
  id          String       @id @default(cuid())
  name        String
  type        String // "entrada" | "saida"
  lancamentos Lancamento[]
  contasPagar ContaPagar[]
  createdAt   DateTime     @default(now())
}

// Banco / conta financeira
model Banco {
  id            String       @id @default(cuid())
  name          String
  lancamentos   Lancamento[]
  contasPagar   ContaPagar[]
  configsLibera Config[]     @relation("ContaLiberacao")
  configsRecebe Config[]     @relation("ContaRecebimento")
  createdAt     DateTime     @default(now())
}

// Lançamento financeiro (entrada ou saída). Pagamentos de parcelas geram lançamentos automáticos.
// Conta a pagar: despesa PREVISTA, com vencimento no futuro. Fica separada de
// Lancamento (que é o dinheiro que de fato entrou/saiu) — ao marcar como paga,
// gera o Lancamento de saída correspondente e o saldo só muda nessa hora.
model ContaPagar {
  id         String    @id @default(cuid())
  descricao  String
  valor      Float
  vencimento DateTime
  pago       Boolean   @default(false)
  pagoEm     DateTime?
  observacao String?

  categoria    LancamentoCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  categoriaId  String?
  banco        Banco?               @relation(fields: [bancoId], references: [id], onDelete: SetNull)
  bancoId      String?
  // Lançamento gerado quando a conta foi paga (some junto se ela for estornada).
  lancamentoId String?

  // Recorrência: a conta "mãe" guarda a regra e as ocorrências apontam pra ela.
  // recorrenciaMeses = null numa conta recorrente significa ILIMITADA — nesse
  // caso o job diário vai criando as próximas conforme o tempo passa, em vez
  // de gerar infinitas linhas de uma vez.
  recorrente       Boolean      @default(false)
  recorrenciaMeses Int?
  origem           ContaPagar?  @relation("Recorrencia", fields: [origemId], references: [id], onDelete: Cascade)
  origemId         String?
  ocorrencias      ContaPagar[] @relation("Recorrencia")

  createdAt DateTime @default(now())
}

model Lancamento {
  id              String               @id @default(cuid())
  type            String // "entrada" | "saida"
  amount          Float
  description     String?
  date            DateTime             @default(now())
  categoria       LancamentoCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  categoriaId     String?
  banco           Banco?               @relation(fields: [bancoId], references: [id], onDelete: SetNull)
  bancoId         String?
  contact         Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       String?
  parcelaId       String? // referência à parcela (se gerado automaticamente)
  // Vincula os dois lançamentos (saída na origem + entrada no destino) de uma
  // transferência entre contas (item 133) — mesmo valor nos dois, pra achar
  // o par e não deixar editar um lado sem o outro.
  transferenciaId String?
  createdAt       DateTime             @default(now())
}

// Meta específica de um dia da semana (item 118) — sábado não rende igual a
// terça, então cada dia pode ter sua própria meta. Campo null = usa o padrão
// global (Config) nesse dia. diaSemana: 0 = domingo ... 6 = sábado.
model MetaDiaSemana {
  id                       String @id @default(cuid())
  diaSemana                Int    @unique
  metaVendasMinima         Int?
  metaVendasMedia          Int?
  metaVendasDia            Int?
  metaPctRecebimentoMinima Float?
  metaPctRecebimentoMedia  Float?
  metaPctRecebimento       Float?
}

// Retrato de como foi cada dia: as metas que estavam valendo, o tamanho da
// carteira naquele momento e o que de fato aconteceu.
//
// Existe porque a meta de recebimento é uma % dos leads que estão em
// "Recebimento" — um número que muda todo dia. Sem gravar, consultar um dia
// passado recalculava a meta sobre a carteira de hoje e dava um número que
// nunca foi a meta real daquele dia.
model MetaDiaria {
  id  String   @id @default(cuid())
  dia DateTime @unique // meia-noite UTC da data local

  // Metas de vendas vigentes no dia (quantidade de leads liberados).
  metaVendasMinima Int
  metaVendasMedia  Int
  metaVendasDia    Int

  // Regra de recebimento vigente (% da carteira) e a carteira daquele dia —
  // este totalEmRecebimento é o dado que não dá pra recuperar depois.
  metaPctRecebimentoMinima Float
  metaPctRecebimentoMedia  Float
  metaPctRecebimento       Float
  totalEmRecebimento       Int

  // Metas de recebimento em nº de clientes, já resolvidas pela carteira do dia.
  metaRecebimentosMinima Int
  metaRecebimentosMedia  Int
  metaRecebimentosDia    Int

  // Resultado do dia. Fica gravado pra montar histórico e gráfico sem varrer
  // parcela por parcela — mas ao abrir um dia específico o sistema recalcula
  // esses números do dado real, que é exato.
  vendas          Int   @default(0)
  recebimentos    Int   @default(0)
  baixas          Int   @default(0)
  valorRecebido   Float @default(0)
  valorVendido    Float @default(0) // soma do capital liberado no dia
  valorRecuperado Float @default(0) // parte do recebido que estava ATRASADA

  // Metas de valor vigentes no dia (em R$).
  metaValorVendasMinima Float @default(0)
  metaValorVendasMedia  Float @default(0)
  metaValorVendasDia    Float @default(0)
  metaRecuperacaoMinima Float @default(0)
  metaRecuperacaoMedia  Float @default(0)
  metaRecuperacaoDia    Float @default(0)

  // Tamanho da carteira por responsável naquele dia, em JSON
  // ({"Kabrito": 12, "Maria": 8}). É o que permite a meta de recebimento POR
  // USUÁRIO em dias passados — igual ao total, não dá pra recuperar depois.
  carteiraPorUsuario String?

  atualizadoEm DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// Log de auditoria — quem fez o quê, quando. Cobre as ações mais sensíveis
// (mudar etapa, excluir, dar/desfazer baixa, mudar permissão), não literalmente
// tudo, pra não virar ruído.
model AuditLog {
  id         String   @id @default(cuid())
  usuario    String?
  acao       String // "mover_etapa" | "excluir_contato" | "dar_baixa" | "estornar_baixa" | "excluir_lancamento" | "alterar_permissao" | "excluir_usuario" | ...
  entidade   String // "Contact" | "Parcela" | "Lancamento" | "User" | ...
  entidadeId String?
  detalhe    String?
  createdAt  DateTime @default(now())
}

// Controle de espécie: dinheiro que o cobrador recebe na rua não entra no
// caixa da empresa até ele depositar. "recebido" nasce automático quando uma
// baixa é registrada com formaPagamento = "dinheiro"; "depositado" é lançado
// manualmente. saldoEmMaos(usuario) = soma(recebido) - soma(depositado).
model EspecieMovimento {
  id         String   @id @default(cuid())
  usuario    String
  tipo       String // "recebido" | "depositado"
  valor      Float
  parcelaId  String? // preenchido quando nasceu de uma baixa em dinheiro
  observacao String?
  createdAt  DateTime @default(now())
}

// Prestação de contas do dia, preenchida pelo próprio cobrador ao encerrar —
// não substitui os números reais do sistema, é o relato dele pra bater.
model PrestacaoContas {
  id               String   @id @default(cuid())
  usuario          String
  dia              DateTime // meia-noite UTC do dia
  visitas          Int?
  recebidoDinheiro Float?
  recebidoPix      Float?
  observacao       String?
  createdAt        DateTime @default(now())

  @@unique([usuario, dia])
}

// Fechamento semanal de comissão (seg-sáb) — snapshot do que foi calculado,
// com fluxo de aprovação antes de considerar pago. Sem isso a comissão fica
// só "calculada na tela", sem nunca virar um compromisso fechado.
model ComissaoFechamento {
  id               String    @id @default(cuid())
  usuario          String
  semanaInicio     DateTime // segunda-feira, meia-noite UTC
  semanaFim        DateTime // sábado
  valorRecuperado  Float
  diasBatidos      Int       @default(0) // quantos dias da semana bateram a meta diária
  bonusDiarioTotal Float     @default(0)
  bateuSemanal     Boolean   @default(false)
  bonusSemanal     Float     @default(0)
  bonusProgressivo Float     @default(0) // item 221
  qtdPerdas        Int       @default(0) // item 223
  descontoPerdas   Float     @default(0) // item 223
  valorTotal       Float
  status           String    @default("pendente") // "pendente" | "aprovado" | "pago"
  aprovadoPor      String?
  aprovadoEm       DateTime?
  pagoEm           DateTime?
  createdAt        DateTime  @default(now())

  @@unique([usuario, semanaInicio])
}

// Mensagem agendada pra sair numa data/hora futura — reaproveita uma mensagem
// pronta (MessageTemplate) já existente em vez de duplicar corpo/mídia aqui.
model MensagemAgendada {
  id         String           @id @default(cuid())
  contact    Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String
  numero     WhatsappNumber   @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  numeroId   String
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  corpo      String? // texto livre, quando não usa um template
  dataHora   DateTime
  enviado    Boolean          @default(false)
  enviadoEm  DateTime?
  erro       String?
  createdAt  DateTime         @default(now())
}

// Campanha de envio em massa segmentada: escolhe um filtro de contatos (o
// mesmo formato usado no filtro de Contatos), uma mensagem, e dispara com
// espaçamento aleatório (5-15s) igual o lembrete de cobrança — protege contra
// bloqueio do número por volume.
model CampanhaMassa {
  id          String    @id @default(cuid())
  nome        String
  filtros     String // JSON — mesmo formato do filtro de Contatos
  templateId  String?
  mensagem    String? // texto livre, quando não usa um template
  numeroId    String
  status      String    @default("rascunho") // "rascunho" | "enviando" | "concluida" | "cancelada"
  totalAlvos  Int       @default(0)
  enviados    Int       @default(0)
  falhas      Int       @default(0)
  criadoPor   String?
  createdAt   DateTime  @default(now())
  iniciadoEm  DateTime?
  concluidoEm DateTime?
}

// Mensagem trocada com o contato pelo WhatsApp (Evolution API)
model Message {
  id        String    @id @default(cuid())
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  body      String    @default("") // texto / legenda
  kind      String    @default("text") // text | audio | image | document
  mediaUrl  String? // caminho do arquivo (áudio/imagem/anexo)
  mimeType  String?
  fileName  String?
  fromMe    Boolean   @default(true) // true = enviada por nós, false = recebida do cliente
  status    String    @default("sent")
  instance  String? // instância da Evolution que originou/enviou (controle de visibilidade por usuário)
  readAt    DateTime? // null = não visualizada pelo operador
  // "Apagar" (item 88) só remove da NOSSA visualização — o WhatsApp não tem
  // uma API confiável pra apagar "dos dois lados" sem risco de request
  // malformado num provedor ao vivo, então isso fica só do nosso lado.
  apagada   Boolean   @default(false)
  createdAt DateTime  @default(now())
}
